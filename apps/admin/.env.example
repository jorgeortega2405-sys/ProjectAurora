ADMIN_APP_NAME="ProjectAurora Admin"
ADMIN_PORT=3005
ADMIN_BASE_URL=http://localhost:3005
NODE_ENV=development
ADMIN_VITE_PORT=5175

# BASE DE DATOS MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aurora_user
DB_PASSWORD=aurora_password
DB_NAME=db_aurora

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# CASSANDRA TELEMETRY
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=aurora_telemetry

# ALMACENAMIENTO DE OBJETOS S3 / MINIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aurora-storage
S3_FORCE_PATH_STYLE=true

# SEGURIDAD Y SESION
SESSION_SECRET=aurora_session_secret_key_2026_super_secure

# CLOUDFLARE TURNSTILE (CAPTCHA INVISIBLE)
TURNSTILE_ENABLED=true
# Claves de prueba oficiales de Cloudflare (Modo Invisible):
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB
