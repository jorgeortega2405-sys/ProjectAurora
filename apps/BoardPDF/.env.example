APP_NAME=BoardPDF
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ALMACENAMIENTO DE OBJETOS S3 / MINIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=boardpdf-storage
S3_FORCE_PATH_STYLE=true

# EMAIL (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="BoardPDF"

# SEGURIDAD Y SESIÓN
SESSION_SECRET=boardpdf_session_secret_key_2026_super_secure

# PHOTOROOM API
PHOTOROOM_API_KEY=
PHOTOROOM_ENDPOINT=https://sdk.photoroom.com/v1/segment

# GOOGLE GEMINI AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# DEEPL API
DEEPL_API_KEY=

# DROPBOX API
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# GOOGLE DRIVE PICKER API
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# CLOUDFLARE TURNSTILE (CAPTCHA)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# PROTECCIÓN DE ORIGEN
ENFORCE_CLOUDFLARE_ORIGIN=false
CLOUDFLARE_ORIGIN_SECRET=
