APP_NAME=ProjectAurora
BASE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_aurora
DB_USER=aurora_user
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ALMACENAMIENTO DE OBJETOS S3 / MINIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aurora-storage
S3_FORCE_PATH_STYLE=true

SESSION_SECRET=your_strong_session_secret_here

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ProjectAurora
 
PHOTOROOM_API_KEY=
PHOTOROOM_ENDPOINT=https://sdk.photoroom.com/v1/segment

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# CLOUDFLARE TURNSTILE (CAPTCHA INVISIBLE)
TURNSTILE_ENABLED=true
# Claves de prueba oficiales de Cloudflare para desarrollo (Modo Invisible):
# Para producción, reemplaza con tus claves del panel de Cloudflare
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# BLINDAJE DE SERVIDOR DE ORIGEN (CLOUDFLARE ORIGIN PROTECTION)
# Activa en producción (true) para bloquear accesos directos a la IP que evadan Cloudflare
ENFORCE_CLOUDFLARE_ORIGIN=false
CLOUDFLARE_ORIGIN_SECRET=
