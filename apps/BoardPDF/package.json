{
  "name": "boardpdf",
  "version": "1.0.0",
  "description": "BoardPDF - PDF Tools SPA Application and Backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "tsx watch --exclude \"logs/**\" --exclude \"dist/**\" --exclude \"client/**\" --exclude \"public/**\" --exclude \"data/**\" --exclude \"temp_storage/**\" src/index.ts",
    "dev:client": "vite",
    "dev:watch": "tsx watch --exclude \"logs/**\" --exclude \"dist/**\" --exclude \"client/**\" --exclude \"public/**\" --exclude \"data/**\" src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/adversarial-challenger-routes.test.mjs tests/challenger-m1-router-edge-cases.test.mjs tests/challenger-m1-translation-integrity.test.mjs && tsx tests/seo-dynamic-urls.test.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:all": "npm run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@popperjs/core": "^2.11.8",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "qr-code-styling": "^1.9.2",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.15",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.10",
    "@types/sortablejs": "^1.15.9",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "ws": "^8.22.0"
  }
}
